<% html_title t("discord.project_settings.new_title") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("discord.project_settings.new_title") }
    header.with_breadcrumbs(
      [
        { href: project_path(@project), text: @project.name },
        { href: project_settings_discord_channels_path(@project), text: t("discord.project_settings.title") },
        t("discord.project_settings.new_title")
      ]
    )
  end
%>

<%= render "form", channel: @channel, submit_label: t(:button_create) %>
